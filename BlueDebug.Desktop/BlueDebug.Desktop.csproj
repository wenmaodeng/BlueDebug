<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows10.0.17763.0 让 Plugin.BLE 在 Windows 上使用原生 WinRT 蓝牙实现；
         net10.0 供 macOS/Linux 构建运行（蓝牙不可用时程序会给出提示而非崩溃）。 -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- 允许在 macOS/Linux 上交叉编译 Windows 目标 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueDebug\BlueDebug.csproj" />
  </ItemGroup>
</Project>
